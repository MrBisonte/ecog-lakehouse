# Allow list. Everything is ignored unless a rule below re-includes it.
*
!*/
!.gitignore
!README.md
!LICENSE
!CLAUDE.md
!Makefile
!pyproject.toml
!CITATION.cff
!REUSE.toml
!LICENSES/*.txt
!sbom.cdx.json
!doc/**/*.md
!adr/*.md
!pipeline/**/*.py
!sql/**/*.sql
!tests/**/*.py
!scripts/**/*.py
!scripts/**/*.sh
!faults/**/*.py
!faults/**/*.sql
!faults/**/*.sh
!contracts/*.yaml
!governance/*.csv
!docs/index.html
!docs/*.md
!/docs/data/LICENSE.md
# Bulk data never enters the repository, whatever the extension.
/data/
/docs/data/**
!/docs/data/LICENSE.md
# The published copy is the one data inside the repo (spec 9): Gold, fault files, manifest,
# checks and lineage macros, written by make publish and make bench, within the limits.
!/docs/data/**/
!/docs/data/**/*.parquet
!/docs/data/**/*.json
!/docs/data/**/*.sql
keyring.duckdb
*.duckdb
*.duckdb.wal
*.mat
